<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.shiftworks.megatron.acordado</string>
  <!-- caffeinate: -s impede o sono do sistema (na tomada), -i o sono ocioso, -m o do disco. -->
  <key>ProgramArguments</key><array>
    <string>/usr/bin/caffeinate</string><string>-s</string><string>-i</string><string>-m</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
