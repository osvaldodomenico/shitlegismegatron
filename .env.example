# ============================================================================
# MEGATRON — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores do seu ambiente.
# `.env` está no .gitignore — não commitar.
# ============================================================================

# === Feed do TSE ===
# Esquema confirmado contra a CDN em producao (probe 19/09/2026):
#   https://resultados.tse.jus.br/oficial/ele2026/<ELE>/dados-simplificados/<abr>/<abr>-c<CCCC>-e<ELEICA>-r.json
#
# Em PRODUCAO (dia da eleicao):
#   TSE_BASE_URL=https://resultados.tse.jus.br/oficial/ele2026
#
# Em DEV (sem TSE aberto), use o simulator interno (subir com `docker compose --profile dev up`):
TSE_BASE_URL=http://simulator:8001/oficial/ele2026

# Intervalo de polling (recomendado pelo TSE: nao inferior a 60s)
POLL_INTERVAL_SECONDS=60

# === Codigos de eleicao ===
# ATENCAO: o TSE usa UM CODIGO POR ABRANGENCIA, nao um por turno.
#   ELE_1T     -> eleicoes por UF  (governador, senador, dep. federal/estadual)
#   ELE_1T_BR  -> eleicao nacional (presidente, abrangencia "br")
#
# Confirmado em 2022:  544 = presidente (br) | 546 = cargos por UF (1T)
#                      547 = governador 2T (por UF)
#
# Como descobrir os codigos de 2026 (o TSE publica semanas antes):
#   scripts/descobrir_ele.sh   — varre os codigos e imprime os que respondem 200
ELE_1T=TBD
ELE_1T_BR=TBD
ELE_2T=TBD
ELE_2T_BR=TBD

# === Monitoramento ===
# UFs: siglas minusculas separadas por virgula.
# 'br' eh OBRIGATORIO para acompanhar presidente — o TSE nao publica
# presidente por UF, nem governador/senador/deputado sob 'br'. Pares
# incoerentes sao descartados automaticamente pelo collector.
# Cargos: presidente, governador, senador, dep_federal, dep_estadual
UFS=sp,rj,mg,rs,ba,pr,pe,ce,pa,sc,br
CARGOS=presidente,governador,senador,dep_federal,dep_estadual

# === Infra ===
REDIS_URL=redis://redis:6379
POSTGRES_USER=megatron
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=megatron

# === Simulator (apenas em DEV com --profile dev) ===
DURACAO_SIMULACAO=3600

# === HTTPS publico (producao) ===
# Token do Cloudflare para o Caddy emitir certificado via DNS-01 challenge.
# Criar em: https://dash.cloudflare.com/profile/api-tokens
#   - Permissions: Zone / DNS / Edit
#   - Zone Resources: Include / Specific zone / shiftworks.app.br
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE=shiftworks.app.br
MEGATRON_DOMAIN=megatron.shiftworks.app.br