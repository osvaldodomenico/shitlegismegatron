# ============================================================================
# MEGATRON — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores do seu ambiente.
# `.env` está no .gitignore — não commitar.
# ============================================================================

# === Feed do TSE ===
# Esquema oficial conforme "Instrucoes para download dos arquivos da
# Divulgacao de resultados" (TSE, 2024).
#
# Quando o TSE abrir a divulgacao em OUT/2026, o feed oficial sera:
#   https://resultados.tse.jus.br/oficial/ele2026/<ELE>/dados/<uf>/<uf>-c<CCCC>-e<ELE>-u.json
#
# Em DEV (sem TSE aberto), use o simulator interno (subir com `docker compose --profile dev up`):
TSE_BASE_URL=http://simulator:8001/oficial/ele2026

# Intervalo de polling (recomendado pelo TSE: nao inferior a 60s)
POLL_INTERVAL_SECONDS=60

# === Codigo da eleicao (ELE_1T / ELE_2T) ===
# 6 digitos. Descobrir de 2 formas:
#   1) Google: "resultados.tse.jus.br ele2026 544" ou similar
#   2) Via API do TSE: curl https://resultados.tse.jus.br/oficial/ele2026/ele.json
#      (cada entrada do array tem um campo "ele" com o codigo numerico).
#
# Valores historicos: 544 (1T 2022), 545 (2T 2022), 619 (1T 2024 SP),
#                    618 (1T 2024 MG), 666 (1T 2024 POA), ...
# Preencher quando o TSE publicar (tipicamente algumas semanas antes da eleicao).
ELE_1T=TBD
ELE_2T=TBD

# === Monitoramento ===
# UFs: siglas minusculas separadas por virgula. Use 'br' para agregado nacional
#      (presidente).
# Cargos: presidente, governador, senador, dep_federal, dep_estadual
UFS=sp,rj,mg,rs,ba,pr,pe,ce,pa,sc,br
CARGOS=presidente,governador,senador,dep_federal,dep_estadual

# === Infra ===
REDIS_URL=redis://redis:6379
POSTGRES_USER=megatron
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=megatron

# === Simulator (apenas em DEV com --profile dev) ===
DURACAO_SIMULACAO=3600

# === HTTPS publico (producao) ===
# Token do Cloudflare para o Caddy emitir certificado via DNS-01 challenge.
# Criar em: https://dash.cloudflare.com/profile/api-tokens
#   - Permissions: Zone / DNS / Edit
#   - Zone Resources: Include / Specific zone / shiftworks.app.br
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE=shiftworks.app.br
MEGATRON_DOMAIN=megatron.shiftworks.app.br