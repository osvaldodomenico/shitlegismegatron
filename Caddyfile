# MEGATRON — reverse proxy via Caddy
# Dominio: megatron.shiftworks.app.br (Cloudflare proxy ON)
# TLS: emitido via DNS-01 challenge (modulo cloudflare embutido).
#
# Upstreams por NOME DE SERVICO do compose (api, frontend), resolvidos pelo
# DNS interno do Docker. A versao anterior fixava os IPs dos containers
# (172.18.0.6 / 172.18.0.7): qualquer `docker compose up` que recriasse um
# container mudava o IP e derrubava o site ate alguem editar este arquivo
# na mao. Com nome de servico, o proxy sobrevive a recriacao.

{
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

{$MEGATRON_DOMAIN:megatron.shiftworks.app.br} {
    encode gzip zstd

    # 1) API: rotas REST + WebSocket
    @api {
        path /health
        path /resultados/*
        path /historico/*
        path /ws/*
    }
    reverse_proxy @api api:8000 {
        transport http {
            dial_timeout 30s
            response_header_timeout 30s
        }
    }

    # 2) Frontend: todo o resto (HTML, JS, CSS, /assets/*)
    reverse_proxy frontend:3000 {
        transport http {
            dial_timeout 30s
            response_header_timeout 30s
        }
    }

    log {
        output stdout
        level INFO
    }
}
